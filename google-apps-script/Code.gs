/** APK MANAGEMENT - Google Sheets + Apps Script API
 * Setup: isi SPREADSHEET_ID, jalankan setupSheets(), lalu jalankan createFirstAdmin() sekali.
 * Deploy Web App: Execute as Me; akses Anyone. Keamanan akses dilakukan melalui token dan role di API.
 */
const SPREADSHEET_ID = 'PASTE_GOOGLE_SPREADSHEET_ID';
const SESSION_TTL_SECONDS = 21600;
const SHEETS = {
 Users:['id','name','email','passwordHash','salt','role','status','permissions','createdAt','updatedAt'],
 LoginLogs:['id','userId','email','event','timestamp','ipAddress','deviceType','browser','platform','userAgent','language','screen','timezone','detail'],
 ActivityLogs:['id','userId','email','action','module','description','timestamp','ipAddress'],
 Items:['id','name','category','unit','minStock','createdAt','updatedAt'],
 StockBatches:['id','itemId','itemName','qty','buyPrice','buyDate','expiryDate','supplier','createdAt'],
 StockMovements:['id','itemId','batchId','itemName','type','qty','date','note','userId','createdAt'],
 IncomeCategories:['id','name','createdAt'], ExpenseCategories:['id','name','createdAt'],
 Transactions:['id','type','date','description','categoryId','categoryName','amount','method','userId','createdAt'],
 Settings:['key','value','updatedAt']
};
const DEFAULT_PERMISSIONS=['Dashboard','Stock Barang','Tambah barang','Point of Sale','Keuangan','Tambah transaksi','Lihat laporan'];
function doGet(){return json_({success:true,message:'APK Management API aktif',version:'2.0.0'});}
function doPost(e){const lock=LockService.getScriptLock();try{lock.waitLock(20000);const b=JSON.parse(e?.postData?.contents||'{}');const action=String(b.action||'');const data=route_(action,b);return json_({success:true,data});}catch(err){return json_({success:false,message:err?.message||'Kesalahan server.'});}finally{try{lock.releaseLock()}catch(_){}}}
function route_(a,b){switch(a){
 case 'register':return register_(b);case 'login':return login_(b);case 'logout':return logout_(b);case 'me':return publicUser_(requireSession_(b.token));
 case 'dashboard.summary':requirePermission_(b.token,'Dashboard');return dashboard_();
 case 'stock.list':requirePermission_(b.token,'Stock Barang');return stockList_();case 'stock.add':return addStock_(b);case 'stock.remove':return removeStock_(b);case 'stock.update':return updateStock_(b);
 case 'finance.list':requirePermission_(b.token,'Keuangan');return financeList_();case 'finance.add':return addTransaction_(b);case 'finance.addCategory':return addCategory_(b);case 'finance.delete':return deleteTransaction_(b);
 case 'pos.checkout':return checkout_(b);
 case 'admin.listUsers':requireAdmin_(b.token);return rows_('Users').map(publicUser_);case 'admin.approveUser':return approveUser_(b);case 'admin.setUserStatus':return setUserStatus_(b);case 'admin.setPermissions':return setPermissions_(b);
 case 'admin.loginLogs':requireAdmin_(b.token);return rows_('LoginLogs').slice(-500).reverse();case 'admin.activityLogs':requireAdmin_(b.token);return rows_('ActivityLogs').slice(-500).reverse();
 default:throw new Error('Action tidak dikenal: '+a);
 }}
function setupSheets(){const ss=ss_();Object.keys(SHEETS).forEach(n=>{let sh=ss.getSheetByName(n);if(!sh)sh=ss.insertSheet(n);if(sh.getLastRow()===0)sh.appendRow(SHEETS[n]);});return 'Sheet berhasil disiapkan.';}
// Jalankan manual sekali dari Apps Script setelah setupSheets(). Ganti email/password di bawah.
function createFirstAdmin(){const email='admin@example.com',password='GANTI_PASSWORD_ADMIN_MINIMAL_8_KARAKTER',name='Administrator';if(password.indexOf('GANTI_')===0)throw new Error('Ganti password pada fungsi createFirstAdmin() terlebih dahulu.');if(rows_('Users').some(x=>norm_(x.email)===email))throw new Error('Email admin sudah ada.');const salt=Utilities.getUuid();append_('Users',[id_(),name,email,hash_(password,salt),salt,'admin','active',JSON.stringify(DEFAULT_PERMISSIONS),new Date(),new Date()]);return 'Admin awal berhasil dibuat: '+email;}
function register_(b){const name=String(b.name||'').trim(),email=norm_(b.email),password=String(b.password||'');if(name.length<2||!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email))throw Error('Nama atau email tidak valid.');if(password.length<8)throw Error('Password minimal 8 karakter.');if(rows_('Users').some(x=>norm_(x.email)===email))throw Error('Email sudah terdaftar.');const salt=Utilities.getUuid();append_('Users',[id_(),name,email,hash_(password,salt),salt,'staff','pending',JSON.stringify(['Dashboard']),new Date(),new Date()]);loginLog_('',email,'REGISTER_PENDING',b.client,'Menunggu persetujuan admin');return {status:'pending'};}
function login_(b){const email=norm_(b.email),password=String(b.password||''),u=rows_('Users').find(x=>norm_(x.email)===email),c=b.client||{};if(!u||hash_(password,u.salt)!==u.passwordHash){loginLog_(u?.id||'',email,'LOGIN_FAILED',c,'Email atau password salah');throw Error('Email atau password salah.');}if(u.status!=='active'){loginLog_(u.id,email,'LOGIN_BLOCKED',c,'Status akun: '+u.status);throw Error(u.status==='pending'?'Akun menunggu persetujuan admin.':'Akun dinonaktifkan.');}const token=Utilities.getUuid()+Utilities.getUuid();CacheService.getScriptCache().put('session_'+token,JSON.stringify({id:u.id,client:c}),SESSION_TTL_SECONDS);loginLog_(u.id,email,'LOGIN_SUCCESS',c,'Login berhasil');activity_(u,'LOGIN','Auth','Pengguna login',c.ipAddress||'');return {token,user:publicUser_(u)};}
function logout_(b){if(b.token){const key='session_'+b.token,raw=CacheService.getScriptCache().get(key);if(raw){const s=JSON.parse(raw),u=rows_('Users').find(x=>x.id===s.id);if(u){loginLog_(u.id,u.email,'LOGOUT',s.client||{},'Logout berhasil');activity_(u,'LOGOUT','Auth','Pengguna logout',(s.client||{}).ipAddress||'');}}CacheService.getScriptCache().remove(key);}return {loggedOut:true};}
function approveUser_(b){requireAdmin_(b.token);const u=rows_('Users').find(x=>x.id===b.userId);if(!u)throw Error('User tidak ditemukan.');updateById_('Users',u.id,{status:'active',role:b.role==='admin'?'admin':'staff',updatedAt:new Date()});activity_(requireAdmin_(b.token),'USER_APPROVE','Manajemen User','Menyetujui '+u.email);return {updated:true};}
function setUserStatus_(b){const admin=requireAdmin_(b.token);if(b.userId===admin.id)throw Error('Admin tidak dapat menonaktifkan akunnya sendiri.');if(!['active','blocked'].includes(b.status))throw Error('Status tidak valid.');updateById_('Users',b.userId,{status:b.status,updatedAt:new Date()});activity_(admin,'USER_STATUS','Manajemen User','Status '+b.userId+' diubah menjadi '+b.status);return {updated:true};}
function setPermissions_(b){requireAdmin_(b.token);if(!Array.isArray(b.permissions))throw Error('Format izin tidak valid.');updateById_('Users',b.userId,{permissions:JSON.stringify(b.permissions),updatedAt:new Date()});activity_(requireAdmin_(b.token),'USER_PERMISSION','Pengaturan','Hak akses diperbarui untuk '+b.userId);return {updated:true};}
function stockList_(){return {items:rows_('Items'),batches:rows_('StockBatches'),movements:rows_('StockMovements')};}
function addStock_(b){const u=requirePermission_(b.token,'Tambah barang'),name=String(b.name||'').trim(),qty=Number(b.qty),buyDate=String(b.buyDate||''),expiry=String(b.expiryDate||'');if(!name||!Number.isFinite(qty)||qty<=0||!buyDate||!expiry||expiry<buyDate)throw Error('Data barang tidak valid.');const all=rows_('StockBatches');if(all.some(x=>String(x.itemName).toLowerCase()===name.toLowerCase()&&dateOnly_(x.buyDate)===buyDate&&dateOnly_(x.expiryDate)===expiry))throw Error('Batch nama barang, tanggal beli, dan expired tersebut sudah ada.');let item=rows_('Items').find(x=>String(x.name).toLowerCase()===name.toLowerCase());if(!item){item={id:id_(),name,category:String(b.category||'Umum'),unit:String(b.unit||'pcs'),minStock:Number(b.minStock||0)};append_('Items',[item.id,item.name,item.category,item.unit,item.minStock,new Date(),new Date()]);}const bid=id_();append_('StockBatches',[bid,item.id,name,qty,Number(b.buyPrice||0),buyDate,expiry,String(b.supplier||''),new Date()]);append_('StockMovements',[id_(),item.id,bid,name,'IN',qty,buyDate,'Barang masuk',u.id,new Date()]);activity_(u,'STOCK_IN','Stock Barang',`Barang masuk ${name} (${qty})`);return {batchId:bid};}
function removeStock_(b){const u=requirePermission_(b.token,'Stock Barang'),qty=Number(b.qty),batch=rows_('StockBatches').find(x=>x.id===b.batchId);if(!batch||qty<=0||qty>Number(batch.qty))throw Error('Batch tidak ditemukan atau stok tidak mencukupi.');const remaining=Number(batch.qty)-qty;updateById_('StockBatches',batch.id,{qty:remaining});append_('StockMovements',[id_(),batch.itemId,batch.id,batch.itemName,'OUT',qty,String(b.date||today_()),String(b.note||''),u.id,new Date()]);activity_(u,'STOCK_OUT','Stock Barang',`Barang keluar ${batch.itemName} (${qty})`);return {remaining};}
function updateStock_(b){const u=requirePermission_(b.token,'Edit barang'),batch=rows_('StockBatches').find(x=>x.id===b.batchId);if(!batch)throw Error('Batch tidak ditemukan.');const name=String(b.itemName||batch.itemName).trim(),buyDate=String(b.buyDate||batch.buyDate),expiry=String(b.expiryDate||batch.expiryDate);if(!name||expiry<buyDate)throw Error('Data batch tidak valid.');updateById_('StockBatches',batch.id,{itemName:name,buyDate,expiryDate:expiry,buyPrice:Number(b.buyPrice||0),supplier:String(b.supplier||'')});activity_(u,'STOCK_UPDATE','Stock Barang','Batch diperbarui: '+name);return {updated:true};}
function financeList_(){return {transactions:rows_('Transactions'),incomeCategories:rows_('IncomeCategories'),expenseCategories:rows_('ExpenseCategories')};}
function addCategory_(b){const u=requirePermission_(b.token,'Keuangan'),type=b.type==='expense'?'expense':'income',name=String(b.name||'').trim();if(!name)throw Error('Nama kategori wajib diisi.');const tab=type==='income'?'IncomeCategories':'ExpenseCategories';if(rows_(tab).some(x=>String(x.name).toLowerCase()===name.toLowerCase()))throw Error('Kategori sudah ada.');const id=id_();append_(tab,[id,name,new Date()]);activity_(u,'CATEGORY_ADD','Keuangan',`Kategori ${type}: ${name}`);return {id};}
function addTransaction_(b){const u=requirePermission_(b.token,'Tambah transaksi');return insertTransaction_(b,u);}
function insertTransaction_(b,u){const type=b.type==='expense'?'expense':'income',amount=Number(b.amount),date=String(b.date||today_()),description=String(b.description||'').trim(),categoryId=String(b.categoryId||''),categoryName=String(b.categoryName||'').trim();if(!description||!Number.isFinite(amount)||amount<=0||!categoryName)throw Error('Data transaksi tidak valid.');const id=id_();append_('Transactions',[id,type,date,description,categoryId,categoryName,amount,String(b.method||'Tunai'),u.id,new Date()]);activity_(u,'TRANSACTION_ADD','Keuangan',`${type}: ${description} (${amount})`);return {id};}
function deleteTransaction_(b){const u=requirePermission_(b.token,'Keuangan');deleteById_('Transactions',b.id);activity_(u,'TRANSACTION_DELETE','Keuangan','Transaksi dihapus '+b.id);return {deleted:true};}
function checkout_(b){const u=requirePermission_(b.token,'Point of Sale');const cart=Array.isArray(b.items)?b.items:[];if(!cart.length)throw Error('Keranjang masih kosong.');let total=0;cart.forEach(x=>{const batch=rows_('StockBatches').find(y=>y.id===x.batchId),qty=Number(x.qty);if(!batch||qty<=0||qty>Number(batch.qty))throw Error('Stok tidak cukup untuk '+(batch?.itemName||'barang'));});cart.forEach(x=>{const batch=rows_('StockBatches').find(y=>y.id===x.batchId),qty=Number(x.qty),price=Number(x.price||batch.buyPrice||0);updateById_('StockBatches',batch.id,{qty:Number(batch.qty)-qty});append_('StockMovements',[id_(),batch.itemId,batch.id,batch.itemName,'OUT',qty,today_(),'Penjualan POS',u.id,new Date()]);total+=qty*price;});insertTransaction_({type:'income',date:today_(),description:'Penjualan POS '+(b.note||''),categoryId:'',categoryName:'Penjualan POS',amount:total,method:b.method||'Tunai'},u);activity_(u,'POS_CHECKOUT','Point of Sale','Checkout '+cart.length+' jenis barang, total '+total);return {total};}
function dashboard_(){const batches=rows_('StockBatches'),items=rows_('Items'),tx=rows_('Transactions'),moves=rows_('StockMovements'),today=today_(),month=today.slice(0,7),now=new Date();const sum=(type,list=tx)=>list.filter(x=>x.type===type).reduce((a,x)=>a+Number(x.amount||0),0);const monthly=[];for(let i=5;i>=0;i--){const d=new Date(now.getFullYear(),now.getMonth()-i,1),key=Utilities.formatDate(d,tz_(),'yyyy-MM'),label=Utilities.formatDate(d,tz_(),'MMM');const monthTx=tx.filter(x=>String(x.date).slice(0,7)===key);const monthMoves=moves.filter(x=>String(x.date).slice(0,7)===key);monthly.push({month:label,stockIn:monthMoves.filter(x=>x.type==='IN').reduce((a,x)=>a+Number(x.qty||0),0),stockOut:monthMoves.filter(x=>x.type==='OUT').reduce((a,x)=>a+Number(x.qty||0),0),income:monthTx.filter(x=>x.type==='income').reduce((a,x)=>a+Number(x.amount||0),0),expense:monthTx.filter(x=>x.type==='expense').reduce((a,x)=>a+Number(x.amount||0),0)});}const qty=batches.reduce((a,x)=>a+Number(x.qty||0),0),low=items.filter(it=>{const q=batches.filter(b=>b.itemId===it.id).reduce((a,b)=>a+Number(b.qty||0),0);return q<=Number(it.minStock||0)});const exp=batches.filter(b=>b.expiryDate&&dateOnly_(b.expiryDate)>=today&&((new Date(dateOnly_(b.expiryDate)+'T00:00:00')-new Date(today+'T00:00:00'))/86400000)<=30&&Number(b.qty)>0);return {totalQty:qty,itemCount:items.length,batchCount:batches.length,stockValue:batches.reduce((a,b)=>a+Number(b.qty||0)*Number(b.buyPrice||0),0),incomeMonth:sum('income',tx.filter(x=>String(x.date).slice(0,7)===month)),expenseMonth:sum('expense',tx.filter(x=>String(x.date).slice(0,7)===month)),incomeAll:sum('income'),expenseAll:sum('expense'),transactionsToday:tx.filter(x=>x.date===today).length,lowStock:low.length,nearExpiry:exp.length,monthly,recent:rows_('ActivityLogs').slice(-8).reverse()};}
function requireSession_(token){if(!token)throw Error('Sesi tidak ditemukan.');const raw=CacheService.getScriptCache().get('session_'+token);if(!raw)throw Error('Sesi kedaluwarsa. Silakan login kembali.');const s=JSON.parse(raw),u=rows_('Users').find(x=>x.id===s.id);if(!u||u.status!=='active')throw Error('Akun tidak aktif.');return u;}
function requireAdmin_(t){const u=requireSession_(t);if(u.role!=='admin')throw Error('Akses khusus admin.');return u;}
function requirePermission_(t,p){const u=requireSession_(t);if(u.role==='admin')return u;const a=parse_(u.permissions,[]);if(!a.includes(p))throw Error('Anda tidak memiliki izin: '+p);return u;}
function publicUser_(u){return {id:u.id,name:u.name,email:u.email,role:u.role,status:u.status,permissions:parse_(u.permissions,[])};}
function loginLog_(uid,email,event,c,detail){c=c||{};append_('LoginLogs',[id_(),uid,email,event,new Date(),c.ipAddress||'Tidak tersedia',c.deviceType||'',c.browser||'',c.platform||'',c.userAgent||'',c.language||'',c.screen||'',c.timezone||'',detail||'']);}
function activity_(u,action,module,description,ip){append_('ActivityLogs',[id_(),u.id,u.email,action,module,description,new Date(),ip||'']);}
function rows_(name){const sh=sheet_(name),v=sh.getDataRange().getValues();if(v.length<2)return [];const h=v[0];return v.slice(1).filter(r=>r.some(x=>x!=='' )).map(r=>{const o={};h.forEach((k,i)=>o[k]=r[i] instanceof Date?Utilities.formatDate(r[i],tz_(),"yyyy-MM-dd'T'HH:mm:ss"):r[i]);return o;});}
function append_(n,r){sheet_(n).appendRow(r);}function updateById_(n,id,c){const sh=sheet_(n),v=sh.getDataRange().getValues(),h=v[0],col=h.indexOf('id');for(let i=1;i<v.length;i++)if(String(v[i][col])===String(id)){Object.keys(c).forEach(k=>{const j=h.indexOf(k);if(j>=0)sh.getRange(i+1,j+1).setValue(c[k]);});return;}throw Error('Data tidak ditemukan.');}
function deleteById_(n,id){const sh=sheet_(n),v=sh.getDataRange().getValues(),h=v[0],col=h.indexOf('id');for(let i=1;i<v.length;i++)if(String(v[i][col])===String(id)){sh.deleteRow(i+1);return;}throw Error('Data tidak ditemukan.');}
function ss_(){if(SPREADSHEET_ID==='PASTE_GOOGLE_SPREADSHEET_ID')throw Error('Isi SPREADSHEET_ID di Code.gs.');return SpreadsheetApp.openById(SPREADSHEET_ID);}function sheet_(n){const s=ss_().getSheetByName(n);if(!s)throw Error('Sheet '+n+' belum ada. Jalankan setupSheets().');return s;}
function norm_(v){return String(v||'').trim().toLowerCase();}function parse_(v,d){try{return JSON.parse(v||'');}catch(_){return d;}}function id_(){return Utilities.getUuid();}function hash_(p,s){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,s+p,Utilities.Charset.UTF_8).map(b=>('0'+((b+256)%256).toString(16)).slice(-2)).join('');}function tz_(){return Session.getScriptTimeZone()||'Asia/Makassar';}function today_(){return Utilities.formatDate(new Date(),tz_(),'yyyy-MM-dd');}function dateOnly_(v){return String(v||'').slice(0,10);}function json_(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON);}
